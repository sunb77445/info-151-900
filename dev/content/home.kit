<body>
  <div id="blue-bar" class="blue-banner">
    Close the ad!
    <button id="close-bar-btn">X</button>
  </div>

  <section id="home" class="content-padding">
    <section>
      <h1 class="green-list-item section-title">Home</h1>

      <p class="body-grey-text home-p">
        My name is Suki Zhu, a computer science second-year student! This website is all about me.
      </p>

      <blockquote class="body-grey-text home-p">
        <strong>Professional Philosophy:</strong><br />
        <em>"The real problem is that programmers have spent far too much time worrying about efficiency in the wrong places and at the wrong times."</em><br />
        — Donald Knuth
      </blockquote>

      <div class="home-info">
        <img src="img/portfolio/bo.png.PNG" alt="Photo of Suki Zhu" style="width: 80px; height: 80px; object-fit: cover; border-radius: 50%;" />
      </div>
    </section>
  </section>

  <!-- 👇 JavaScript to close the blue banner -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const closeBtn = document.getElementById("close-bar-btn");
      const blueBar = document.getElementById("blue-bar");

      closeBtn.addEventListener("click", function () {
        blueBar.style.display = "none";
      });
    });
  </script>
</body>
